# =============================================================================
# ghidra-mcp lab monorepo — root .gitignore
# =============================================================================
# mcp-server/ has its own detailed ignore for the upstream GhidraMCP tree.
# This file covers the lab wrapper: Ghidra Assist, samples, scripts, macos.
# =============================================================================

# ----- OS -----
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini
*~

# ----- Editors / IDE -----
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.swp
*.swo
*~

# ----- Secrets / local env -----
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets/
*.secret

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
ENV/
.env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# ----- Java / Maven / Gradle (all modules) -----
**/target/
**/build/
**/.gradle/
**/out/
*.class
*.jar
*.war
*.ear
*.nar
# Keep intentional wrapper jars if added later:
!**/gradle/wrapper/gradle-wrapper.jar

# Built extension zips (rebuild via scripts)
*.zip
!docs/**/*.zip

# ----- Node (if ever added) -----
node_modules/
npm-debug.log*
yarn-error.log*

# ----- Ghidra Assist / agent runtime -----
findings/
**/findings/
.cursor/agent-transcripts/
.cursor/*.log

# ----- Samples / RE artifacts -----
# Keep intentional challenge binaries under samples/**/bin/ tracked.
# Ignore debug symbols, unpack backups, and local dumps.
**/*.dSYM/
**/*.packed
samples/**/bin/*.dump
samples/**/bin/*_unpacked
samples/**/*.id0
samples/**/*.id1
samples/**/*.id2
samples/**/*.nam
samples/**/*.til
samples/**/*.i64
samples/**/*.gpr
samples/**/*.rep/
samples/**/*.lock

# Local malware detonation drops (never commit live malware)
malware_inbox/
detonation/
samples/malware/

# ----- macOS Ghidra.app launcher (generated by install script) -----
macos/Ghidra.app/
# Keep source icons + README:
!macos/icons/
!macos/README.md

# ----- mcp-server upstream build / venv (also in mcp-server/.gitignore) -----
mcp-server/target/
mcp-server/dist/
mcp-server/.venv/
mcp-server/.gradle/
mcp-server/**/__pycache__/
mcp-server/logs/
mcp-server/*.log

# ----- Logs / temp -----
*.log
logs/
tmp/
temp/
*.tmp
*.bak
*.orig

# ----- Archives / large local caches -----
*.7z
*.rar
.cache/
.hf_cache/
